[Unit]
Description=Twice Weekly Database Backup Timer
Documentation=https://git.nclf.net/ajfite/server-backup-scripts

[Timer]
# Mondays and Thursdays at ~4:00 AM Pacific Time, after the Mastodon cleanup
OnCalendar=Mon,Thu *-*-* 04:00:00 America/Los_Angeles
RandomizedDelaySec=15m
# Catch up if the server was powered off during the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
