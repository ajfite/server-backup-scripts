[Unit]
Description=Twice Weekly Mastodon Remote Content Cleanup Timer
Documentation=https://git.nclf.net/ajfite/server-backup-scripts

[Timer]
# Sundays and Wednesdays at 10:00 PM Pacific Time, so it is done before the 4:00 AM
# Monday and Thursday backups
OnCalendar=Sun,Wed *-*-* 22:00:00 America/Los_Angeles
Persistent=true

[Install]
WantedBy=timers.target
