[Unit]
Description=Daily Server Backup Timer
Documentation=https://git.nclf.net/ajfite/server-backup-scripts

[Timer]
# Run daily at ~4:00 AM Pacific Time (Washington State)
OnCalendar=*-*-* 04:00:00 America/Los_Angeles
RandomizedDelaySec=15m
# Catch up if the server was powered off during the scheduled time
Persistent=true

[Install]
WantedBy=timers.target
