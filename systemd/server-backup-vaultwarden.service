[Unit]
Description=Vaultwarden Backup and Rotation Service
Documentation=https://git.nclf.net/ajfite/server-backup-scripts
OnFailure=server-alert@%n.service
After=network.target docker.service mariadb.service postgresql.service

[Service]
Type=oneshot
User=root
Group=root

# Pipx binary search path (supports both standard 'sudo pipx install' in /root/.local/bin
# and 'sudo pipx install --global' in /usr/local/bin)
Environment="PYTHONUNBUFFERED=1"
Environment="PATH=/root/.local/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ExecStart using /usr/bin/env to locate the pipx-installed entry point in PATH
ExecStart=/usr/bin/env backup \
    --backup-dir /opt/backup-management \
    --export-dir /home/backup-user/backups \
    --export-user backup-user \
    --only vaultwarden

# Process limits & lower I/O priority during runs
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# No [Install] section: this only runs from server-backup-vaultwarden.timer, not at boot
